{
  "name": "iaquasenso-backend",
  "version": "1.0.0",
  "description": "Backend API for Iaquasenso Reports",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
